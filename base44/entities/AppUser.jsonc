{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del usuario de sistema Base44 (vinculaci\u00f3n)"
    },
    "email": {
      "type": "string",
      "description": "Email corporativo"
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Rol de sistema Base44"
    },
    "position": {
      "type": "string",
      "enum": [
        "oficial",
        "supervisor",
        "gerente",
        "admin"
      ],
      "default": "oficial",
      "description": "Cargo funcional en el negocio"
    },
    "department": {
      "type": "string",
      "description": "Departamento o \u00e1rea"
    },
    "branch": {
      "type": "string",
      "description": "Agencia/Sucursal asignada"
    },
    "supervisor_id": {
      "type": "string",
      "description": "ID del supervisor"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL del avatar"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "general",
        "inversiones",
        "hipotecario",
        "pyme"
      ],
      "default": "general"
    },
    "monthly_budget": {
      "type": "number",
      "default": 50000,
      "description": "Presupuesto mensual de ventas asignado"
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "full_name",
    "role",
    "position",
    "department",
    "branch",
    "phone",
    "avatar_url",
    "supervisor_id"
  ]
}